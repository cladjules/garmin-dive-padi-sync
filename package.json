{
  "name": "garmin-dive-padi-sync",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev:extension": "node scripts/build.mjs --watch",
    "lint": "eslint .",
    "package": "pnpm build && node scripts/package.mjs",
    "pretty": "prettier --check .",
    "pretty:fix": "prettier --write .",
    "store:assets": "pnpm build && STORE_ASSETS_DIRECTORY=store/assets/screenshots playwright test __tests__/browser/extensionSmoke.spec.ts --config=playwright.config.ts && node scripts/generateStorePromo.mjs",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test --config=playwright.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "verify": "pnpm lint && pnpm pretty && pnpm type-check && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "fit-file-parser": "6.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chrome": "0.1.31",
    "@types/node": "26.6.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "4.0.4",
    "esbuild": "0.25.11",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.0.4"
  }
}
